# 可选：管理界面/API 允许的 Host（逗号分隔不支持，仅单个）。
# 留空表示任意域名都可以访问管理界面，适合通过 FRP 直接暴露本服务。
TUNNELHUB_UI_HOST=

# 可选：服务子域后缀。设置后每个服务还可通过 <service_id>.<后缀> 在根路径访问
#（需要通配 DNS，如 *.example.com）。留空则仅使用同源路径 /proxy/<service_id>/。
TUNNELHUB_SERVICE_DOMAIN=

# 宿主机映射端口
TUNNELHUB_PORT=8088

# 默认启用 Secure Cookie；仅在明确使用纯 HTTP 且浏览器不接受 localhost Secure Cookie 时，才设置为 false
TUNNELHUB_COOKIE_SECURE=true